# Copy to .env and fill in. Never commit .env.

# Models: Groq first, OpenRouter if Groq fails (LLM_MODE=auto). Use groq / openrouter to force one.
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_MODE=auto

# Data: local Parquet export (default) or a Databricks SQL warehouse
TILLWISE_BACKEND=duckdb
# TILLWISE_GOLD_DIR=data/gold
# TILLWISE_BACKEND=databricks
# TILLWISE_CATALOG=tillwise
# DATABRICKS_SERVER_HOSTNAME=
# DATABRICKS_HTTP_PATH=
# DATABRICKS_TOKEN=
